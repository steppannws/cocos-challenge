#!/usr/bin/env sh
# Enabled by scripts/setup-hooks.sh (core.hooksPath), which the `prepare` script runs on install.
# gitleaks is optional. When installed, a secret in the staged diff blocks the commit here,
# before it reaches a remote where CI would find it in history.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || exit 1
fi
exec scripts/verify.sh
